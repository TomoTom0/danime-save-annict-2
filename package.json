{
  "name": "danime-save-annict-2",
  "version": "0.6.4.0",
  "description": "dアニメストア, Amazon Prime Video, AbemaTVの視聴結果をAnnictに送信します。Webhookも送信できます。",
  "scripts": {
    "build": "npm run build:ts && npm run build:bundle && npm run build:css && npm run build:copy",
    "build:ts": "tsc --noEmit",
    "build:bundle": "esbuild src/scripts/index.ts --bundle --tree-shaking=false --format=iife --outfile=dist/scripts/index.js --sourcemap && esbuild src/scripts/options.ts --bundle --tree-shaking=false --format=iife --outfile=dist/scripts/options.js --sourcemap",
    "build:css": "sass src/styles:dist/styles",
    "build:copy": "cpx 'src/html/**/*' dist/html && cpx 'src/img/**/*' dist/img && cpx 'src/manifest.json' dist",
    "watch": "npm run watch:ts & npm run watch:bundle & npm run watch:css",
    "watch:ts": "tsc --watch --noEmit",
    "watch:bundle": "esbuild src/scripts/index.ts --bundle --tree-shaking=false --format=iife --outfile=dist/scripts/index.js --sourcemap --watch & esbuild src/scripts/options.ts --bundle --tree-shaking=false --format=iife --outfile=dist/scripts/options.js --sourcemap --watch",
    "watch:css": "sass --watch src/styles:dist/styles",
    "test": "cd tests && npm test"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.268",
    "@types/jest": "^30.0.0",
    "cpx": "^1.5.0",
    "esbuild": "^0.28.2",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "sass": "^1.77.0",
    "ts-jest": "^29.4.6",
    "typescript": "^5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/TomoTom0/danime-save-annict-2.git"
  },
  "author": "TomoTom0",
  "license": "MIT"
}
