{
  "name": "danime-save-annict-2-tests",
  "version": "0.6.4.0",
  "description": "テストスイート for danime-save-annict-2 Chrome拡張機能",
  "private": true,
  "scripts": {
    "test": "jest --config jest.config.js",
    "test:unit": "jest --config jest.config.js unit/",
    "test:integration": "jest --config jest.config.js integration/",
    "test:integration-chrome": "playwright test",
    "test:integration-chrome:xvfb": "xvfb-run -a playwright test",
    "test:watch": "jest --config jest.config.js --watch",
    "test:coverage": "jest --config jest.config.js --coverage",
    "test:ci": "jest --config jest.config.js --ci --coverage --watchAll=false",
    "playwright:install": "playwright install"
  },
  "devDependencies": {
    "@jest/globals": "^29.0.0",
    "@playwright/test": "^1.62.1",
    "@types/chrome": "^0.1.36",
    "@types/jest": "^30.0.0",
    "eslint": "^8.50.0",
    "jest": "^29.0.0",
    "jest-environment-jsdom": "^29.0.0",
    "playwright-core": "^1.62.1",
    "ts-jest": "^29.4.6",
    "typescript": "^5.9.3"
  },
  "eslintConfig": {
    "env": {
      "browser": true,
      "es2021": true,
      "jest": true,
      "webextensions": true
    },
    "extends": [
      "eslint:recommended"
    ],
    "parserOptions": {
      "ecmaVersion": 2021,
      "sourceType": "module"
    },
    "globals": {
      "chrome": "readonly"
    },
    "rules": {
      "no-unused-vars": "error",
      "no-undef": "error",
      "no-console": "warn"
    }
  }
}
